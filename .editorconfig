# Monorepo: Rust trading bots, Python research, TypeScript dashboard, Markdown library.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

# Rust: rustfmt defaults.
[*.rs]
indent_size = 4
max_line_length = 100

# Python: black/ruff defaults.
[*.py]
indent_size = 4
max_line_length = 88

[*.{pyi,ipynb}]
indent_size = 4

# Web: prettier defaults.
[*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,vue,svelte,css,scss,html}]
indent_size = 2
max_line_length = 100

[*.{json,jsonc,json5,yml,yaml,toml}]
indent_size = 2

# Markdown: two trailing spaces are a hard line break and must survive.
[*.md]
indent_size = 2
trim_trailing_whitespace = false
max_line_length = off

# Data files are written by tools; leave their bytes alone.
[*.csv]
trim_trailing_whitespace = false
insert_final_newline = unset
max_line_length = off

[Makefile]
indent_style = tab

[*.{sh,bash}]
indent_size = 2

[*.fish]
indent_size = 4
